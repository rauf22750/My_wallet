SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key

# Only needed to apply the database schema; never exposed to the browser.
DATABASE_URL=postgresql://postgres:tyg8_Lr8k4h?CS7.your-project.supabase.co:5432/postgres
# Server only: enables admin-created accounts. Never exposed to browser config.
SUPABASE_SERVICE_ROLE_KEY=

# CA certificate used to verify the database SSL connection.
DATABASE_SSL_CA_PATH=supabase/prod-ca-2021.crt
